# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL connection
POSTGRES_USER: app_user
POSTGRES_PASSWORD:
POSTGRES_DB: app_database

DB_URL: jdbc:postgresql://postgres-db:5432/app_database
DB_USER: app_user
DB_PASSWORD:

# Mail (Mailpit on the compose network — see docker-compose.yaml)
# Mailpit captures every send; open http://localhost:8025 to read them.
spring.mail.host=mailpit
spring.mail.port=1025
spring.mail.username=
spring.mail.password=
spring.mail.protocol=smtp
spring.mail.properties.mail.smtp.auth=false
spring.mail.properties.mail.smtp.starttls.enable=false
app.mail.from=no-reply@zurimpact.local
app.base-url=http://localhost:3000
